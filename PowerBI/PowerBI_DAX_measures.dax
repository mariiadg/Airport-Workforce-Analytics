// DAX-меры для дашборда "Agents details"

// 1. Среднее рейсов за смену
Avg Flights per Shift =
DIVIDE(
    SUM(m1_all_agents[total_flights]),
    SUM(m1_all_agents[shift_amount]),
    BLANK()
)


// 2. Среднее зарегистрированных пассажиров за смену
Avg Checked Pax per Shift =
DIVIDE(
    SUM(m1_all_agents[ctotal_pax]),
    SUM(m1_all_agents[shift_amount]),
    BLANK()
)


// 3. Среднее посаженных пассажиров за смену
Avg Boarded Pax per Shift =
DIVIDE(
    SUM(m1_all_agents[btotal_pax]),
    SUM(m1_all_agents[shift_amount]),
    BLANK()
)


// 4. Сокращённое название типа агента
Agent Type Short =
SWITCH(
    TRUE(),
    SELECTEDVALUE(m1_all_agents[agent_type_ru]) = "Состав смены", "Осн. состав",
    SELECTEDVALUE(m1_all_agents[agent_type_ru]) = "Дополнительный агент", "Доп. агент",
    BLANK()
)